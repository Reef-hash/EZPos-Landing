@{
    ViewData["Title"] = "Catalysm — Perisian untuk Perniagaan Malaysia";
}

<style>
    /* ── Hero ── */
    .hero {
        padding: 110px 24px 90px;
        text-align: center;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.18);
        border-radius: 20px;
        padding: 5px 16px;
        font-size: .78rem;
        font-weight: 600;
        color: #d97706;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 28px;
    }

    .hero-eyebrow::before {
        content: '';
        display: inline-block;
        width: 6px; height: 6px;
        background: var(--amber);
        border-radius: 50%;
    }

    .hero h1 {
        font-size: clamp(2.4rem, 5.5vw, 4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -2px;
        margin-bottom: 22px;
    }

    .hero h1 em { color: var(--amber); font-style: normal; }

    .hero-sub {
        font-size: 1.1rem;
        color: #9ca3af;
        max-width: 580px;
        margin: 0 auto 40px;
        line-height: 1.75;
    }

    .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    /* ── Stats bar ── */
    .stats-row {
        display: flex;
        gap: 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        max-width: 1100px;
        margin: 0 auto;
    }

    .stat-item {
        flex: 1;
        padding: 32px 24px;
        text-align: center;
        border-right: 1px solid var(--border);
    }
    .stat-item:last-child { border-right: none; }
    .stat-number { font-size: 2.2rem; font-weight: 800; color: var(--amber); display: block; }
    .stat-label { font-size: .82rem; color: var(--muted); margin-top: 4px; }

    @@media (max-width: 640px) {
        .stats-row { flex-direction: column; }
        .stat-item { border-right: none; border-bottom: 1px solid var(--border); }
        .stat-item:last-child { border-bottom: none; }
    }

    /* ── Product tabs ── */
    .tabs-wrap {
        display: flex;
        gap: 0;
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        max-width: 380px;
        margin: 0 auto 48px;
    }

    .tab-btn {
        flex: 1;
        padding: 10px 0;
        font-size: .9rem;
        font-weight: 600;
        background: var(--card);
        border: none;
        color: var(--muted);
        cursor: pointer;
        transition: background .18s, color .18s;
    }

    .tab-btn.active {
        background: var(--amber);
        color: #0d0d0d;
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ── Product showcase card ── */
    .product-showcase {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 52px 48px;
    }

    @@media (max-width: 768px) {
        .product-showcase { grid-template-columns: 1fr; gap: 32px; padding: 32px 24px; }
    }

    .product-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .badge-ezpos { background: rgba(245,158,11,.15); color: var(--amber); border: 1px solid rgba(245,158,11,.25); }
    .badge-crossx { background: rgba(99,102,241,.15); color: #818cf8; border: 1px solid rgba(99,102,241,.25); }

    .product-showcase h2 {
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -.5px;
        line-height: 1.2;
        margin-bottom: 14px;
    }

    .product-showcase p.desc {
        color: #9ca3af;
        font-size: .95rem;
        line-height: 1.75;
        margin-bottom: 28px;
    }

    .product-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    .feat-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }

    .feat-list li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: .9rem;
        color: #d1d5db;
    }

    .feat-check {
        flex-shrink: 0;
        width: 20px; height: 20px;
        margin-top: 1px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .feat-check.amber { background: rgba(245,158,11,.15); border: 1px solid rgba(245,158,11,.3); }
    .feat-check.indigo { background: rgba(99,102,241,.15); border: 1px solid rgba(99,102,241,.3); }

    .feat-check svg { width: 11px; height: 11px; }
    .feat-check.amber svg { stroke: var(--amber); }
    .feat-check.indigo svg { stroke: #818cf8; }

    /* ── Platform pills ── */
    .platform-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }

    .platform-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 5px 12px;
        font-size: .78rem;
        color: #9ca3af;
    }

    .platform-pill span { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
    .platform-pill .dot-amber { background: var(--amber); }
    .platform-pill .dot-green { background: #4ade80; }
    .platform-pill .dot-blue  { background: #60a5fa; }

    /* ── Decision section ── */
    .decision-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 680px) { .decision-grid { grid-template-columns: 1fr; } }

    .decision-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 36px 32px;
        transition: border-color .2s;
        text-decoration: none;
        display: block;
    }

    .decision-card:hover { border-color: var(--amber); }

    .decision-icon {
        width: 52px; height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .decision-icon.amber { background: rgba(245,158,11,.12); border: 1px solid rgba(245,158,11,.2); }
    .decision-icon.indigo { background: rgba(99,102,241,.12); border: 1px solid rgba(99,102,241,.2); }

    .decision-icon svg { width: 26px; height: 26px; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .decision-icon.amber svg { stroke: var(--amber); }
    .decision-icon.indigo svg { stroke: #818cf8; }

    .decision-card h3 { font-size: 1.15rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .decision-card p  { font-size: .88rem; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }

    .decision-tag {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 6px;
        font-size: .8rem;
        font-weight: 700;
    }

    .decision-tag.amber { background: rgba(245,158,11,.15); color: var(--amber); }
    .decision-tag.indigo { background: rgba(99,102,241,.15); color: #818cf8; }

    /* ── CTA band ── */
    .cta-band {
        text-align: center;
        padding: 80px 24px;
    }

    .cta-band h2 { font-size: 2rem; font-weight: 800; letter-spacing: -.5px; margin-bottom: 14px; }
    .cta-band p  { color: #9ca3af; margin-bottom: 32px; font-size: .95rem; max-width: 460px; margin-left: auto; margin-right: auto; }
    .cta-band .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    /* ── About section ── */
    .about-section {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .about-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 72px 24px;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 64px;
        align-items: center;
    }

    @@media (max-width: 768px) { .about-inner { grid-template-columns: 1fr; gap: 36px; } }

    .about-avatar {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: rgba(245,158,11,.12);
        border: 2px solid rgba(245,158,11,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 800;
        color: var(--amber);
        margin-bottom: 20px;
        letter-spacing: -1px;
    }

    .about-inner h2 {
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -.5px;
        margin-bottom: 10px;
    }

    .about-inner p {
        color: #9ca3af;
        font-size: .95rem;
        line-height: 1.75;
        margin-bottom: 28px;
    }

    .social-links { display: flex; gap: 12px; flex-wrap: wrap; }

    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 9px 16px;
        font-size: .85rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        transition: border-color .15s, color .15s;
    }

    .social-btn:hover { border-color: var(--amber); color: var(--amber); }
    .social-btn svg { width: 17px; height: 17px; fill: currentColor; }

    .services-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    @@media (max-width: 480px) { .services-list { grid-template-columns: 1fr; } }

    .service-item {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 18px 20px;
    }

    .service-item h4 { font-size: .9rem; font-weight: 700; margin-bottom: 4px; }
    .service-item p  { font-size: .82rem; color: var(--muted); margin: 0; line-height: 1.5; }
</style>

<!-- ─────────── HERO ─────────── -->
<section class="hero">
    <div class="hero-eyebrow">Catalysm &middot; Independent Software Engineer</div>
    <h1>We build software<br />that <em>actually works.</em></h1>
    <p class="hero-sub">Two products. One mission &mdash; giving Malaysian businesses the tools to grow without the technical overhead.</p>
    <div class="hero-actions">
        <a href="#our-products" class="btn-primary">Explore Our Products &darr;</a>
        <a href="https://wa.me/60195778954?text=Hi%20Catalysm%2C%20I%27d%20like%20to%20ask%20about%20your%20products." class="btn-outline" target="_blank">Get in Touch</a>
    </div>
</section>

<!-- ─────────── STATS BAR ─────────── -->
<div class="stats-row container" style="padding:0;">
    <div class="stat-item">
        <span class="stat-number">2</span>
        <div class="stat-label">Active products</div>
    </div>
    <div class="stat-item">
        <span class="stat-number">100%</span>
        <div class="stat-label">Works offline</div>
    </div>
    <div class="stat-item">
        <span class="stat-number">0</span>
        <div class="stat-label">Monthly subscription fees</div>
    </div>
    <div class="stat-item">
        <span class="stat-number">MY</span>
        <div class="stat-label">Built for Malaysia</div>
    </div>
</div>

<!-- ─────────── PRODUCTS SECTION ─────────── -->
<section class="section" id="our-products">
    <div class="container">
        <div style="text-align:center; margin-bottom: 48px;">
            <div class="label-tag">Our Products</div>
            <h2 style="font-size:1.85rem; font-weight:800; letter-spacing:-.5px; margin-bottom:10px; margin-top:4px;">Two products. Two industries.</h2>
            <p style="color:#9ca3af; font-size:.95rem;">Select a tab to learn more about each product.</p>
        </div>

        <!-- Tab buttons -->
        <div class="tabs-wrap">
            <button class="tab-btn active" onclick="switchTab('ezpos', this)">EZPos</button>
            <button class="tab-btn" onclick="switchTab('crossx', this)">CrossxPos</button>
        </div>

        <!-- EZPos Panel -->
        <div class="tab-panel active" id="tab-ezpos">
            <div class="product-showcase">
                <div>
                    <div class="product-badge badge-ezpos">EZPos</div>
                    <h2>Desktop POS for<br />Retail Businesses</h2>
                    <p class="desc">EZPos is built for retail shops, boutiques, pharmacies, and any business selling physical products. Lightweight, fast, and fully functional without an internet connection.</p>
                    <div class="product-actions">
                        <a asp-controller="Home" asp-action="Pricing" class="btn-primary">View EZPos Pricing &rarr;</a>
                        <a asp-controller="Home" asp-action="Index" class="btn-outline">Learn More</a>
                    </div>
                    <div class="platform-pills" style="margin-top:24px;">
                        <div class="platform-pill"><span class="dot-amber"></span> Windows Desktop</div>
                        <div class="platform-pill"><span class="dot-green"></span> Fully Offline</div>
                        <div class="platform-pill"><span class="dot-blue"></span> One-time Payment</div>
                    </div>
                </div>
                <ul class="feat-list">
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Process sales &amp; receipts instantly
                    </li>
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Automated inventory management
                    </li>
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Daily, weekly &amp; monthly sales reports
                    </li>
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Receipt printer &amp; barcode scanner support
                    </li>
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Local data storage — your data stays private
                    </li>
                    <li>
                        <div class="feat-check amber"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        One device, one license, lifetime access
                    </li>
                </ul>
            </div>
        </div>

        <!-- CrossxPos Panel -->
        <div class="tab-panel" id="tab-crossx">
            <div class="product-showcase">
                <div>
                    <div class="product-badge badge-crossx">CrossxPos</div>
                    <h2>Restaurant POS for<br />Modern F&amp;B Operations</h2>
                    <p class="desc">CrossxPos is purpose-built for restaurants, cafés, and F&amp;B businesses. Manage tables, kitchen orders, and billing in one unified system &mdash; on Android, iOS, or any browser.</p>
                    <div class="product-actions">
                        <a asp-controller="CrossxPos" asp-action="Pricing" class="btn-primary" style="background:#818cf8; color:#0d0d0d;">View CrossxPos Pricing &rarr;</a>
                        <a asp-controller="CrossxPos" asp-action="Index" class="btn-outline">Learn More</a>
                    </div>
                    <div class="platform-pills" style="margin-top:24px;">
                        <div class="platform-pill"><span class="dot-amber"></span> Android &amp; iOS</div>
                        <div class="platform-pill"><span class="dot-green"></span> Browser PWA</div>
                        <div class="platform-pill"><span class="dot-blue"></span> Offline-first</div>
                    </div>
                </div>
                <ul class="feat-list">
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Table management &amp; order taking (KOT)
                    </li>
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Real-time Kitchen Display System (KDS)
                    </li>
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Cashier &amp; order void management
                    </li>
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Menu &amp; category management
                    </li>
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Staff access control (RBAC)
                    </li>
                    <li>
                        <div class="feat-check indigo"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        Sales reports &amp; CSV export (Pro)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ─────────── DECISION SECTION ─────────── -->
<div style="background:var(--surface); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container section">
        <div style="text-align:center; margin-bottom:48px;">
            <div class="label-tag">Product Guide</div>
            <h2 style="font-size:1.85rem; font-weight:800; letter-spacing:-.5px; margin-bottom:10px; margin-top:4px;">Which product is right for you?</h2>
            <p style="color:#9ca3af; font-size:.95rem;">Answer one simple question &mdash; we&rsquo;ll point you in the right direction.</p>
        </div>

        <div class="decision-grid">
            <!-- EZPos card -->
            <a href="/Home/Pricing" class="decision-card">
                <div class="decision-icon amber">
                    <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M6 8h.01M9 8h6M6 11h.01M9 11h2"/></svg>
                </div>
                <h3>I run a retail shop or product business</h3>
                <p>Convenience stores, boutiques, pharmacies, laundrettes, hardware stores, or any business selling physical products over a counter.</p>
                <div>
                    <span class="decision-tag amber">Use EZPos &rarr;</span>
                </div>
            </a>

            <!-- CrossxPos card -->
            <a href="/CrossxPos/Pricing" class="decision-card">
                <div class="decision-icon indigo">
                    <svg viewBox="0 0 24 24"><path d="M3 2h18v4H3zM3 10h18v4H3zM3 18h18v4H3z"/><path d="M7 6v4M7 14v4"/><circle cx="17" cy="8" r="1.5"/><circle cx="17" cy="16" r="1.5"/></svg>
                </div>
                <h3>I run a restaurant, caf&eacute;, or F&amp;B business</h3>
                <p>Restaurants, cafés, food courts, cloud kitchens, or any operation managing table orders and kitchen workflow.</p>
                <div>
                    <span class="decision-tag indigo">Use CrossxPos &rarr;</span>
                </div>
            </a>
        </div>

        <p style="text-align:center; color:var(--muted); font-size:.88rem; margin-top:32px;">
            Not sure which to pick? <a href="https://wa.me/60195778954?text=Hi%20Catalysm%2C%20can%20you%20help%20me%20choose%20the%20right%20product%3F" target="_blank" style="color:var(--amber); text-decoration:none;">Chat with us &rarr;</a>
        </p>
    </div>
</div>

<!-- ─────────── CTA BAND ─────────── -->
<section class="cta-band">
    <div class="label-tag">Get Started</div>
    <h2 style="margin-top:12px;">Ready to begin?</h2>
    <p>Pick a product, pay once, and start using it today. No subscriptions. No lock-in.</p>
    <div class="cta-row">
        <a asp-controller="Home" asp-action="Pricing" class="btn-primary">EZPos Pricing &rarr;</a>
        <a asp-controller="CrossxPos" asp-action="Pricing" class="btn-outline">CrossxPos Pricing &rarr;</a>
    </div>
</section>

<!-- ─────────── ABOUT CATALYSM ─────────── -->
<div class="about-section">
    <div class="about-inner">
        <div>
            <div class="about-avatar">R</div>
            <div class="label-tag" style="margin-bottom:14px;">About Catalysm</div>
            <h2>I&rsquo;m Reef &mdash;<br/>Independent Software Engineer</h2>
            <p>Catalysm is my personal brand. I design and build software, websites, landing pages, and applications for Malaysian businesses &mdash; end-to-end, independently.</p>
