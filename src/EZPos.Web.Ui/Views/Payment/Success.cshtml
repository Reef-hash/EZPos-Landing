@{
    ViewData["Title"] = "Payment Successful";
    var isCrossxPos = (ViewBag.ProductType as string) == "CrossxPos";
    var plan        = ViewBag.Plan as string ?? "basic";
    var restaurant  = ViewBag.RestaurantName as string ?? "";
    var planLabel   = plan == "pro" ? "Pro" : "Basic";
}

<style>
    .result-page {
        min-height: calc(100vh - 60px - 72px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
    }

    .result-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        max-width: 560px;
        width: 100%;
        overflow: hidden;
    }

    .result-card-top {
        background: rgba(245,158,11,.06);
        border-bottom: 1px solid rgba(245,158,11,.15);
        padding: 32px 36px;
        text-align: center;
    }

    .success-icon {
        width: 56px; height: 56px;
        background: rgba(245,158,11,.12);
        border: 2px solid rgba(245,158,11,.3);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 16px;
    }

    .success-icon svg { width: 28px; height: 28px; stroke: var(--amber); fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

    .result-card-top h2 { font-size: 1.4rem; font-weight: 800; margin-bottom: 6px; }
    .result-card-top p { color: #9ca3af; font-size: .9rem; margin: 0; }

    .result-card-body { padding: 28px 36px; }

    .key-block {
        background: #0d0d0d;
        border: 1px solid rgba(245,158,11,.25);
        border-radius: 10px;
        padding: 20px 24px;
        text-align: center;
        margin: 20px 0;
    }

    .key-label { font-size: .72rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--amber); margin-bottom: 10px; }

    .key-value {
        font-family: 'Courier New', monospace;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 2px;
        word-break: break-all;
    }

    .key-note { font-size: .78rem; color: #6b7280; margin-top: 10px; margin-bottom: 0; }

    .step-list { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 10px; }

    .step-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: .85rem;
        color: #d1d5db;
    }

    .step-num {
        flex-shrink: 0;
        width: 22px; height: 22px;
        background: rgba(245,158,11,.1);
        border: 1px solid rgba(245,158,11,.2);
        border-radius: 50%;
        font-size: .72rem;
        font-weight: 700;
        color: var(--amber);
        display: flex; align-items: center; justify-content: center;
        margin-top: 1px;
    }
</style>

<div class="result-page">
    <div class="result-card">
        <div class="result-card-top">
            <div class="success-icon">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h2>Payment Successful</h2>
            <p>@(isCrossxPos ? $"CrossxPos {planLabel} for {restaurant} has been activated." : "Thank you for choosing EZPos. Your license key is ready below.")</p>
        </div>
        <div class="result-card-body">
            @if (isCrossxPos)
            {
                <p style="font-size:.8rem; color:#9ca3af; margin-bottom:6px;">Product: <strong style="color:var(--amber)">CrossxPos @planLabel</strong> &mdash; @(plan == "pro" ? "730 days" : "365 days")</p>
                <p style="font-size:.8rem; color:#9ca3af; margin-bottom:16px;">Restaurant: <strong style="color:var(--text)">@restaurant</strong></p>
            }

            <div class="key-block">
                <div class="key-label">Your License Key</div>
                <div class="key-value" id="licenseKey">@ViewBag.LicenseKey</div>
                <p class="key-note">Copy and store this key in a safe place.</p>
            </div>

            <p style="font-size:.82rem; color:#9ca3af; margin-bottom:16px;">Next steps:</p>
            @if (isCrossxPos)
            {
                <ul class="step-list">
                    <li><span class="step-num">1</span> Open CrossxPos on your device (browser / Android / iOS app)</li>
                    <li><span class="step-num">2</span> Go to <strong>Settings &gt; License</strong></li>
                    <li><span class="step-num">3</span> Paste the license key and click <strong>Activate</strong></li>
                </ul>
            }
            else
            {
                <ul class="step-list">
                    <li><span class="step-num">1</span> Open the EZPos desktop app on your computer</li>
                    <li><span class="step-num">2</span> Go to <strong>Settings &gt; License</strong></li>
                    <li><span class="step-num">3</span> Paste the license key above and click <strong>Activate</strong></li>
                </ul>
            }

            <a asp-controller="Home" asp-action="Index" class="btn-outline" style="display:block; text-align:center;">Back to Home</a>
        </div>
    </div>
</div>
