@using EZPos.Web.Ui.Models
@model List<License>
@{
    Layout          = null;
    var search      = ViewData["Search"]       as string ?? "";
    var total       = (int)(ViewData["TotalCount"]   ?? 0);
    var active      = (int)(ViewData["ActiveCount"]  ?? 0);
    var ezCount     = (int)(ViewData["EzPosCount"]   ?? 0);
    var crossxCount = (int)(ViewData["CrossxPosCount"] ?? 0);
    var priceStr    = ViewData["LicensePrice"] as string ?? "499.00";
    var cxBasic     = ViewData["CrossxBasicPrice"] as string ?? "299.00";
    var cxPro       = ViewData["CrossxProPrice"]   as string ?? "499.00";
    var message     = TempData["Message"]      as string;
    var settingsErr = TempData["SettingsError"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EZPos Admin — Dashboard</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: #1a1a1a;
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: #e0e0e0;
        }

        /* ── Top bar ── */
        .topbar {
            background: #242424;
            border-bottom: 1px solid #333;
            padding: 0 28px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar h1 { font-size: 1.1rem; font-weight: 700; color: #FFC107; }
        .topbar span { font-size: .8rem; color: #777; margin-left: 10px; }

        .logout-form { display: inline; }
        .btn-logout {
            background: none;
            border: 1px solid #444;
            border-radius: 5px;
            color: #aaa;
            font-size: .8rem;
            padding: 5px 12px;
            cursor: pointer;
        }
        .btn-logout:hover { border-color: #f87171; color: #f87171; }

        /* ── Main ── */
        main { padding: 28px; max-width: 1200px; margin: 0 auto; }

        /* ── Stats ── */
        .stats {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: #2a2a2a;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 16px 24px;
            min-width: 140px;
        }

        .stat-card .label { font-size: .75rem; color: #777; text-transform: uppercase; letter-spacing: .5px; }
        .stat-card .value { font-size: 1.8rem; font-weight: 700; margin-top: 4px; }
        .stat-card.total  .value { color: #FFC107; }
        .stat-card.active .value { color: #4ade80; }
        .stat-card.deact  .value { color: #f87171; }
        .stat-card.ezpos .value { color: #a78bfa; }
        .stat-card.crossx .value { color: #fbbf24; }

        /* ── Toolbar ── */
        .toolbar {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            align-items: center;
        }

        .search-input {
            flex: 1;
            max-width: 340px;
            padding: 8px 12px;
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: .9rem;
            outline: none;
        }

        .search-input:focus { border-color: #FFC107; }

        .btn-search {
            padding: 8px 16px;
            background: #FFC107;
            border: none;
            border-radius: 6px;
            color: #1a1a1a;
            font-weight: 600;
            font-size: .85rem;
            cursor: pointer;
        }

        .btn-clear {
            padding: 8px 12px;
            background: none;
            border: 1px solid #444;
            border-radius: 6px;
            color: #aaa;
            font-size: .85rem;
            cursor: pointer;
            text-decoration: none;
        }

        /* ── Flash message ── */
        .flash {
            background: rgba(74,222,128,.12);
            border: 1px solid rgba(74,222,128,.3);
            border-radius: 6px;
            padding: 10px 14px;
            color: #4ade80;
            font-size: .85rem;
            margin-bottom: 16px;
        }

        /* ── Table ── */
        .table-wrap {
            background: #2a2a2a;
            border: 1px solid #333;
            border-radius: 8px;
            overflow: hidden;
        }

        table { width: 100%; border-collapse: collapse; font-size: .88rem; }

        thead { background: #242424; }

        th {
            padding: 12px 14px;
            text-align: left;
            font-size: .75rem;
            font-weight: 600;
            color: #777;
            text-transform: uppercase;
            letter-spacing: .5px;
            border-bottom: 1px solid #333;
            white-space: nowrap;
        }

        td {
            padding: 11px 14px;
            border-bottom: 1px solid #2f2f2f;
            vertical-align: middle;
        }

        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #2f2f2f; }

        .key-cell {
            font-family: monospace;
            font-size: .9rem;
            color: #FFC107;
            letter-spacing: .5px;
        }

        .email-cell { color: #a3a3a3; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        .device-cell {
            font-family: monospace;
            font-size: .8rem;
            color: #64748b;
        }

        .badge {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 12px;
            font-size: .75rem;
            font-weight: 600;
        }
        .badge.active { background: rgba(74,222,128,.15); color: #4ade80; }
        .badge.inactive { background: rgba(248,113,113,.15); color: #f87171; }

        /* ── Action buttons ── */
        .actions { display: flex; gap: 6px; flex-wrap: wrap; }

        .btn {
            padding: 5px 11px;
            border-radius: 5px;
            font-size: .78rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .btn-deactivate { background: rgba(248,113,113,.1); border-color: rgba(248,113,113,.3); color: #f87171; }
        .btn-deactivate:hover { background: rgba(248,113,113,.2); }

        .btn-activate { background: rgba(74,222,128,.1); border-color: rgba(74,222,128,.3); color: #4ade80; }
        .btn-activate:hover { background: rgba(74,222,128,.2); }

        .btn-reset { background: rgba(251,191,36,.1); border-color: rgba(251,191,36,.3); color: #fbbf24; }
        .btn-reset:hover { background: rgba(251,191,36,.2); }

        /* ── Settings card ── */
        .settings-card {
            background: #2a2a2a;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 18px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .settings-card label {
            font-size: .8rem;
            color: #777;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .price-input-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .price-prefix {
            color: #FFC107;
            font-weight: 700;
            font-size: 1rem;
        }

        .price-input {
            width: 110px;
            padding: 7px 10px;
            background: #1a1a1a;
            border: 1px solid #444;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: .95rem;
            outline: none;
        }

        .price-input:focus { border-color: #FFC107; }

        .btn-save-price {
            padding: 7px 14px;
            background: #FFC107;
            border: none;
            border-radius: 6px;
            color: #1a1a1a;
            font-weight: 700;
            font-size: .85rem;
            cursor: pointer;
        }

        .btn-save-price:hover { background: #e6ac00; }

        .settings-hint { font-size: .78rem; color: #555; }

        .manual-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }

        .manual-card {
            background: #2a2a2a;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 16px;
        }

        .manual-card h3 {
            color: #e0e0e0;
            margin-bottom: 12px;
            font-size: 1rem;
        }

        .manual-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 10px;
        }

        .manual-field label {
            font-size: .78rem;
            color: #777;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .manual-input,
        .manual-select {
            width: 100%;
            padding: 8px 10px;
            background: #1a1a1a;
            border: 1px solid #444;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: .9rem;
            outline: none;
        }

        .manual-input:focus,
        .manual-select:focus { border-color: #FFC107; }

        .manual-submit {
            margin-top: 6px;
            width: 100%;
            padding: 9px 12px;
            border: none;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
        }

        .manual-submit.ez { background: #8b5cf6; color: #fff; }
        .manual-submit.ez:hover { background: #7c3aed; }
        .manual-submit.cx { background: #f59e0b; color: #1a1a1a; }
        .manual-submit.cx:hover { background: #d97706; }
    </style>
</head>
<body>

    <div class="topbar">
        <div>
            <h1>EZPos Admin</h1>
            <span>License Management</span>
        </div>
        <form class="logout-form" method="post" asp-action="Logout" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">Log Out</button>
        </form>
    </div>

    <main>

        <!-- Stats -->
        <div class="stats">
            <div class="stat-card total">
                <div class="label">Total Keys</div>
                <div class="value">@total</div>
            </div>
            <div class="stat-card active">
                <div class="label">Active</div>
                <div class="value">@active</div>
            </div>
            <div class="stat-card deact">
                <div class="label">Deactivated</div>
                <div class="value">@(total - active)</div>
            </div>
            <div class="stat-card ezpos">
                <div class="label">EZPos Keys</div>
                <div class="value">@ezCount</div>
            </div>
            <div class="stat-card crossx">
                <div class="label">CrossxPos Keys</div>
                <div class="value">@crossxCount</div>
            </div>
        </div>

        <!-- Flash message -->
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="flash">@message</div>
        }

        <!-- Manual key generation (asingkan ikut produk) -->
        <div class="manual-grid">
            <div class="manual-card">
                <h3>Jana Key Manual: EZPos</h3>
                <form method="post" asp-action="CreateManualEzPos" asp-controller="Admin">
                    @Html.AntiForgeryToken()
                    <div class="manual-field">
                        <label>Email Pelanggan (opsyenal)</label>
                        <input class="manual-input" type="email" name="customerEmail" placeholder="customer@email.com" />
                    </div>
                    <button type="submit" class="manual-submit ez">Generate Key EZPos</button>
                </form>
            </div>

            <div class="manual-card">
                <h3>Jana Key Manual: CrossxPos</h3>
                <form method="post" asp-action="CreateManualCrossxPos" asp-controller="Admin">
                    @Html.AntiForgeryToken()
                    <div class="manual-field">
                        <label>Nama Restoran</label>
                        <input class="manual-input" type="text" name="restaurantName" required placeholder="Contoh: Dapur Sempoi" />
                    </div>
                    <div class="manual-field">
                        <label>Plan</label>
                        <select class="manual-select" name="plan">
                            <option value="basic">Basic (365 hari)</option>
                            <option value="pro">Pro (730 hari)</option>
                        </select>
                    </div>
                    <div class="manual-field">
                        <label>Email Pelanggan (opsyenal)</label>
                        <input class="manual-input" type="email" name="customerEmail" placeholder="owner@restaurant.com" />
                    </div>
                    <button type="submit" class="manual-submit cx">Generate Key CrossxPos</button>
                </form>
            </div>
        </div>

        <!-- Settings: Harga Lesen -->
        <div class="settings-card">
            <label>Harga Lesen (RM)</label>
            <form method="post" asp-action="SaveSettings" asp-controller="Admin"
                  style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <div class="price-input-wrap">
                    <span class="price-prefix">RM</span>
                    <input class="price-input" type="number" name="licensePrice"
                           value="@priceStr" min="1" step="0.01" required />
                </div>
                <button type="submit" class="btn-save-price">Simpan Harga EZPos</button>
                @if (!string.IsNullOrEmpty(settingsErr))
                {
                    <span style="color:#f87171;font-size:.82rem;">@settingsErr</span>
                }
                <span class="settings-hint">Harga EZPos (lesen seumur hidup, satu peranti).</span>
            </form>
            <form method="post" asp-action="SaveSettings" asp-controller="Admin"
                  style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px;">
                @Html.AntiForgeryToken()
                <span style="font-size:.8rem;color:#777;">CrossxPos Basic (RM):</span>
                <div class="price-input-wrap">
                    <span class="price-prefix">RM</span>
                    <input class="price-input" type="number" name="crossxBasicPrice"
                           value="@cxBasic" min="1" step="0.01" />
                </div>
                <span style="font-size:.8rem;color:#777;">Pro (RM):</span>
                <div class="price-input-wrap">
                    <span class="price-prefix">RM</span>
                    <input class="price-input" type="number" name="crossxProPrice"
                           value="@cxPro" min="1" step="0.01" />
                </div>
                <button type="submit" class="btn-save-price">Simpan Harga CrossxPos</button>
                <span class="settings-hint">Basic = 365 hari, Pro = 730 hari.</span>
            </form>
        </div>

        <!-- Search -->
        <form method="get" asp-action="Dashboard" asp-controller="Admin">
            <div class="toolbar">
                <input class="search-input" type="text" name="search"
                       value="@search" placeholder="Cari key atau email..." />
                <button type="submit" class="btn-search">Cari</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a class="btn-clear" href="/Admin/Dashboard">Padam</a>
                }
            </div>
        </form>

        <!-- Table -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Produk</th>
                        <th>License Key</th>
                        <th>Email / Nama</th>
                        <th>Tarikh Beli</th>
                        <th>Device / Tamat</th>
                        <th>Status</th>
                        <th>Tindakan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="empty">Tiada rekod dijumpai.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lic in Model)
                        {
                            <tr>
                                <td>@lic.Id</td>
                                <td>
                                    @if (lic.ProductType == "CrossxPos")
                                    {
                                        <span style="color:#FFC107;font-size:.78rem;font-weight:700;">CrossxPos</span>
                                        @if (!string.IsNullOrEmpty(lic.Plan))
                                        {
                                            <span style="color:#555;font-size:.72rem;"> @lic.Plan.ToUpper()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:#9ca3af;font-size:.78rem;">EZPos</span>
                                    }
                                </td>
                                <td class="key-cell" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@lic.KeyString">@lic.KeyString</td>
                                <td class="email-cell" title="@lic.CustomerEmail">
                                    @if (lic.ProductType == "CrossxPos" && !string.IsNullOrEmpty(lic.RestaurantName))
                                    {
                                        <span style="color:#e0e0e0;">@lic.RestaurantName</span><br/>
                                        <span style="color:#555;font-size:.8rem;">@(string.IsNullOrEmpty(lic.CustomerEmail) ? "—" : lic.CustomerEmail)</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(lic.CustomerEmail) ? "—" : lic.CustomerEmail)
                                    }
                                </td>
                                <td>@lic.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="device-cell">
                                    @if (lic.ProductType == "CrossxPos")
                                    {
                                        @if (lic.ExpiresAt.HasValue)
                                        {
                                            var isExpired = lic.ExpiresAt.Value < DateTime.UtcNow;
                                            <span style="color:@(isExpired ? "#f87171" : "#4ade80")">@lic.ExpiresAt.Value.ToString("dd MMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span style="color:#555">—</span>
                                        }
                                    }
                                    else
                                    {
                                        @if (string.IsNullOrEmpty(lic.DeviceId))
                                        {
                                            <span style="color:#555">Belum aktif</span>
                                        }
                                        else
                                        {
                                            <span title="@lic.DeviceId">@lic.DeviceId[..Math.Min(12, lic.DeviceId.Length)]…</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="badge @(lic.IsActive ? "active" : "inactive")">
                                        @(lic.IsActive ? "Aktif" : "Dinyahaktif")
                                    </span>
                                </td>
                                <td>
                                    <div class="actions">
                                        @if (lic.IsActive)
                                        {
                                            <form method="post" asp-action="Deactivate" asp-controller="Admin"
                                                  asp-route-id="@lic.Id"
                                                  onsubmit="return confirm('Nyahaktifkan key @lic.KeyString?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-deactivate">Nyahaktif</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="Activate" asp-controller="Admin"
                                                  asp-route-id="@lic.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-activate">Aktifkan</button>
                                            </form>
                                        }

                                        @if (!string.IsNullOrEmpty(lic.DeviceId))
                                        {
                                            <form method="post" asp-action="ResetDevice" asp-controller="Admin"
                                                  asp-route-id="@lic.Id"
                                                  onsubmit="return confirm('Reset device untuk @lic.KeyString? Key boleh digunakan pada mesin baru.')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-reset">Reset Device</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </main>
</body>
</html>
