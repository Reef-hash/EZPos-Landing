# Backend Environment Variables
# Copy this to .env and fill in the values

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ANON_PUBLIC_KEY=your_supabase_anon_public_key
# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Admin
ADMIN_EMAIL=admin@ezpos.com
ADMIN_PASSWORD_HASH=bcrypt_hashed_password_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Optional: override EZPos installer manifest endpoint
EZPOS_LATEST_JSON_URL=https://raw.githubusercontent.com/Reef-hash/EZPos-Update-System/main/latest.json

# Customer Portal URL (for magic link redirect + email links)
PORTAL_URL=http://localhost:3000/portal/login

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=EZPos <no-reply@yourdomain.com>
